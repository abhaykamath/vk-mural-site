---
import { render, type CollectionEntry } from 'astro:content';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'journal'>;
}

const { locale, entry } = Astro.props;
const strings = t(locale);
const { Content } = await render(entry);

const dateFormat = new Intl.DateTimeFormat(locale === 'en' ? 'en-IN' : `${locale}-IN`, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<main class="py-16 md:py-24">
  <article class="shell max-w-[72ch]">
    <a
      href={`${localePath(locale)}#journal`}
      class="mb-8 inline-block text-[0.85rem] font-semibold text-manjadi no-underline"
    >
      {strings.journal.back}
    </a>

    <p class="flex gap-3 text-[0.75rem] tracking-[0.12em] text-soot-faint uppercase">
      <span>{dateFormat.format(entry.data.date)}</span>
      <span>{entry.data.minutes} {strings.journal.minutes}</span>
    </p>

    <h1 class="mt-3 text-[2.1rem] md:text-[3rem]">{entry.data.title}</h1>
    <p class="mt-5 text-[1.15rem] leading-snug text-soot-soft">{entry.data.excerpt}</p>

    <div
      class="prose-body mt-10 border-t border-lime-edge pt-10 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-[1.5rem] [&_p]:text-soot-soft"
    >
      <Content />
    </div>
  </article>
</main>
