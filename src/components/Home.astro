---
import { getCollection } from 'astro:content';
import { artist, paintings as pieces, strings, whatsappHref } from '../data';
import Lightbox from './Lightbox.astro';

const hero = pieces.find((piece) => piece.slug === 'murali-krishna') ?? pieces[0]!;

const articles = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const section = 'py-(--spacing-gap) scroll-mt-22';
const head = 'mb-10 max-w-[58ch] md:mb-16';
const lead = 'mt-4 text-[1.1rem] leading-snug text-soot-soft md:text-[1.32rem]';
---

<main id="top">
  {/* -------------------------------------------------------------- hero */}
  <section class="pt-12 pb-(--spacing-gap) md:pt-24">
    <div class="shell grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-18">
      <div>
        <p class="eyebrow mb-4">{strings.hero.eyebrow}</p>
        <h1 class="text-[2.6rem] leading-[1.1] font-medium md:text-[3.8rem] lg:text-[5.4rem]">
          {strings.hero.headline}{' '}
          <span class="text-manjadi">{strings.hero.headlineAccent}</span>
        </h1>
        <p class={`${lead} mt-6`}>{strings.hero.lead}</p>

        <div
          class="mt-8 flex flex-wrap gap-x-7 gap-y-2 border-t border-lime-edge pt-6 text-[0.83rem] tracking-wide text-soot-faint"
        >
          <span>{pieces.length} {strings.hero.notes.paintings}</span>
          <span>{strings.hero.notes.medium}</span>
          <span>{artist.location}</span>
        </div>
      </div>

      <figure class="m-0">
        <img
          src={`/${hero.src}`}
          alt={`${hero.name}. ${hero.description}`}
          fetchpriority="high"
          class="mx-auto max-h-[min(66vh,560px)] w-auto max-w-full shadow-[0_1px_0_var(--color-lime-edge),0_30px_60px_-30px_rgba(22,19,15,0.5)]"
        />
        <figcaption class="mt-4 text-center text-[0.8rem] tracking-wide text-soot-faint">
          {hero.name}
          {hero.widthInches && hero.heightInches
            ? `, ${hero.widthInches} x ${hero.heightInches} ${strings.lightbox.inches}`
            : ''}
        </figcaption>
      </figure>
    </div>
  </section>

  {/* -------------------------------------------------------------- work */}
  <section id="work" class={section}>
    <div class="shell">
      <div class={head}>
        <p class="eyebrow mb-4">{strings.work.eyebrow}</p>
        <h2 class="text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">{strings.work.heading}</h2>
        <p class={lead}>{strings.work.lead}</p>
      </div>

      <div class="grid items-start gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-14">
        {
          pieces.map((piece, index) => (
            <button
              type="button"
              data-open-piece={index}
              aria-label={`${piece.name}. ${strings.work.viewLarger}`}
              class="piece block w-full cursor-pointer border-0 bg-transparent p-0 text-left"
            >
              <span class="plate block">
                <img src={`/${piece.src}`} alt={piece.description} loading="lazy" />
              </span>
              <span
                class="mt-5 grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1.5 border-t border-lime-edge pt-4"
              >
                <h3 class="col-start-1 text-[1.25rem] md:text-[1.6rem]">{piece.name}</h3>
                {piece.widthInches && piece.heightInches ? (
                  <span class="col-start-2 row-start-1 text-[0.85rem] whitespace-nowrap tabular-nums text-soot-faint">
                    {piece.widthInches} x {piece.heightInches} {strings.work.unit}
                  </span>
                ) : null}
                {piece.days ? (
                  <span class="col-span-full text-[0.85rem] text-soot-faint">
                    <b class="font-semibold tabular-nums text-manjadi">{piece.days}</b>{' '}
                    {strings.work.days}
                  </span>
                ) : null}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- tradition */}
  <section id="tradition" class={`dark bg-soot text-lime ${section}`}>
    <div class="shell">
      <div class={head}>
        <p class="eyebrow mb-4">{strings.tradition.eyebrow}</p>
        <h2 class="text-lime text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">
          {strings.tradition.heading}
        </h2>
        <p class="mt-4 text-[1.1rem] leading-snug text-lime/75 md:text-[1.32rem]">
          {strings.tradition.lead}
        </p>
      </div>

      <div class="grid gap-px border border-lime/15 bg-lime/15 md:grid-cols-5">
        {
          strings.tradition.pigments.map((pigment, index) => (
            <article class="bg-soot px-5 pt-7 pb-6">
              <i
                class="mb-4 block h-13 w-full rounded-[1px]"
                style={`background: ${['#F5F0E6', '#CF9520', '#A32D1C', '#3D6B4C', '#16130F'][index]}`}
                aria-hidden="true"
              />
              <span class="mb-2 block text-[0.7rem] tracking-[0.14em] text-manjal uppercase">
                {pigment.colour}
              </span>
              <h3 class="mb-1 text-lime text-[1.15rem]">{pigment.name}</h3>
              <p class="text-[0.85rem] leading-relaxed text-lime/60">{pigment.source}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-10 max-w-[62ch] border-l-2 border-manjal pl-6">
        <h3 class="mb-2 text-lime text-[1.15rem]">{strings.tradition.today.heading}</h3>
        <p class="m-0 text-lime/70">{strings.tradition.today.body}</p>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- process */}
  <section id="process" class={section}>
    <div class="shell">
      <div class={head}>
        <p class="eyebrow mb-4">{strings.process.eyebrow}</p>
        <h2 class="text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">{strings.process.heading}</h2>
        <p class={lead}>{strings.process.lead}</p>
      </div>

      <div class="steps grid gap-7 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
        {
          strings.process.steps.map((step) => (
            <article class="step border-t-2 border-soot pt-5">
              <h3 class="mb-2 text-[1.15rem]">{step.title}</h3>
              <p class="text-[0.93rem] text-soot-soft">{step.body}</p>
            </article>
          ))
        }
      </div>

      <figure class="mx-auto mt-16 max-w-[46ch] text-center md:mt-24">
        <blockquote class="m-0">
          <p class="font-display text-[1.5rem] leading-snug text-balance md:text-[2.1rem]">
            {strings.quote.text}
          </p>
        </blockquote>
        <figcaption class="mt-5 text-[0.75rem] tracking-[0.16em] text-soot-faint uppercase">
          {strings.quote.attribution}
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ------------------------------------------------------------- about */}
  <section id="about" class={section}>
    <div class="shell grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-18">
      <figure class="m-0">
        <img
          src="/images/vandana.jpg"
          alt={strings.about.portraitAlt}
          width="896"
          height="1195"
          loading="lazy"
          class="w-full shadow-[0_1px_0_var(--color-lime-edge),0_24px_50px_-30px_rgba(22,19,15,0.45)]"
        />
      </figure>

      <div>
        <p class="eyebrow mb-4">{strings.about.eyebrow}</p>
        <h2 class="text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">{strings.about.heading}</h2>
        <div class="prose-body mt-6 text-soot-soft">
          {strings.about.biography.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <ul class="mt-8 grid max-w-[68ch] list-none gap-3.5 p-0">
          {
            strings.about.facts.map((fact) => (
              <li class="grid gap-1 border-b border-lime-edge pb-3.5 text-[0.92rem] sm:grid-cols-[8.5rem_1fr] sm:gap-4">
                <b class="pt-0.5 text-[0.78rem] font-semibold tracking-[0.1em] text-soot-faint uppercase">
                  {fact.label}
                </b>
                <span>{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- journal */}
  <section id="journal" class={section}>
    <div class="shell">
      <div class={head}>
        <p class="eyebrow mb-4">{strings.journal.eyebrow}</p>
        <h2 class="text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">{strings.journal.heading}</h2>
        <p class={lead}>{strings.journal.lead}</p>
      </div>

      {
        articles.length === 0 ? (
          <p class="text-soot-faint">{strings.journal.empty}</p>
        ) : (
          <div class="grid gap-7 md:grid-cols-3 lg:gap-12">
            {articles.map((article) => (
              <a
                href={`/journal/${article.id}/`}
                class="group flex flex-col border-t-2 border-soot pt-5 no-underline transition-colors hover:border-manjadi"
              >
                <span class="mb-3 flex gap-3 text-[0.75rem] tracking-[0.12em] text-soot-faint uppercase">
                  <span>{dateFormat.format(article.data.date)}</span>
                  <span>{article.data.minutes} {strings.journal.minutes}</span>
                </span>
                <h3 class="mb-2 text-[1.25rem] md:text-[1.6rem]">{article.data.title}</h3>
                <p class="mb-4 text-[0.93rem] text-soot-soft">{article.data.excerpt}</p>
                <span class="mt-auto text-[0.85rem] font-semibold text-manjadi">
                  {strings.journal.readMore}
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- contact */}
  <section id="contact" class={`dark bg-soot text-lime ${section}`}>
    <div class="shell grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <p class="eyebrow mb-4">{strings.contact.eyebrow}</p>
        <h2 class="text-lime text-[1.9rem] md:text-[2.5rem] lg:text-[3.1rem]">
          {strings.contact.heading}
        </h2>
        <p class="mt-4 text-[1.1rem] leading-snug text-lime/75 md:text-[1.32rem]">
          {strings.contact.lead}
        </p>
        <p class="mt-5 max-w-[68ch] text-lime/75">{strings.contact.note}</p>
      </div>

      <div class="grid gap-4">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4.5 border border-lime/20 bg-lime/5 px-6 py-5 no-underline transition-all hover:-translate-y-0.5 hover:border-lime/40 hover:bg-lime/10"
        >
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" class="shrink-0" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.58-.35z" />
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z" />
          </svg>
          <span>
            <b class="mb-0.5 block font-display text-[1.15rem] font-semibold">{strings.contact.whatsapp}</b>
            <span class="text-[0.85rem] break-words text-lime/65">{artist.whatsappDisplay}</span>
          </span>
        </a>

        <a
          href={`mailto:${artist.email}`}
          class="flex items-center gap-4.5 border border-lime/20 bg-lime/5 px-6 py-5 no-underline transition-all hover:-translate-y-0.5 hover:border-lime/40 hover:bg-lime/10"
        >
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
            <path d="m3 6.5 9 6.5 9-6.5" />
          </svg>
          <span>
            <b class="mb-0.5 block font-display text-[1.15rem] font-semibold">{strings.contact.email}</b>
            <span class="text-[0.85rem] break-words text-lime/65">{artist.email}</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</main>

<Lightbox />
