---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { artist, getHeroPainting, strings } from '../data';

interface Props {
  /** Path below the root, for example '' or 'journal/why-the-gods-are-green'. */
  path?: string;
  title?: string;
  description?: string;
  image?: string;
}

const { path = '', title, description, image } = Astro.props;

/*
 * The social card is the painting that leads the site.
 *
 * It used to be a hardcoded path to one particular file, which meant changing
 * the lead painting in the CMS left every shared link still showing the old one.
 * Generated here at build time, so it is a local file and follows the choice
 * made in the CMS.
 */
const hero = await getHeroPainting();
const heroCard = hero
  ? await getImage({
      src: hero.imageUrl,
      width: 1200,
      height: Math.round((1200 * hero.imageHeight) / hero.imageWidth),
      format: 'jpeg',
    })
  : null;

const socialImage = image ?? heroCard?.src ?? '/favicon.svg';

const pageTitle = title ? `${title} | ${artist.name}` : strings.meta.title;
const pageDescription = description ?? strings.meta.description;
const canonical = new URL(path ? `/${path}/` : '/', Astro.site).href;

/** Eczar for display, Karla for body. Nothing else is loaded. */
const FONTS = 'family=Eczar:wght@400;500;600;700&family=Karla:wght@300;400;500;600';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#F5F0E6" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? strings.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={new URL(socialImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${FONTS}&display=swap`} rel="stylesheet" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a
      href="#work"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-soot focus:px-5 focus:py-3 focus:text-lime"
    >
      {strings.nav.skip}
    </a>
    <slot />
  </body>
</html>
